{
  "name": "shopmallx",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "build:cf": "next build && npx --no-install @cloudflare/next-on-pages && node scripts/copy-redirects.mjs",
    "start": "next start -p 3000",
    "lint": "next lint",
    "d1:migrate": "wrangler d1 migrations apply shopmallx-db --remote",
    "d1:seed": "wrangler d1 execute shopmallx-db --file=./migrations/0002_seed.sql --remote --yes",
    "d1:export": "node scripts/export-d1-seed.mjs > migrations/0002_seed.sql",
    "deploy": "npm run build:cf && wrangler pages deploy .vercel/output/static --project-name=shopmallx --commit-dirty=true --branch=main"
  },
  "dependencies": {
    "@cf-wasm/photon": "^0.4.0",
    "@vercel/og": "^1.0.3",
    "bcryptjs": "^2.4.3",
    "html2canvas": "^1.4.1",
    "jose": "^5.9.6",
    "jspdf": "^4.2.1",
    "next": "14.2.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.4.0",
    "swiper": "^11.1.15",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@cloudflare/workers-types": "^5.20260921.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.7.2",
    "wrangler": "^4.135.0"
  }
}
